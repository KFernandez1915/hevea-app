<%- include('partials/head', { titre: 'Connexion Planteur' }) %>
<div class="login-wrap">
  <h1>Connexion Planteur</h1>
  <p class="subtitle">Consultez votre pesee et votre montant du mois</p>
  <% if (erreur) { %>
    <div class="alert error"><%= erreur %></div>
  <% } %>
  <form method="POST" action="/planteur/connexion">
    <div class="form-group">
      <label>Identifiant</label>
      <input type="text" name="identifiant" required autofocus>
    </div>
    <div class="form-group">
      <label>Mot de passe</label>
      <input type="password" name="mot_de_passe" required>
    </div>
    <button class="btn green" style="width:100%;" type="submit">Se connecter</button>
  </form>
  <p class="muted" style="text-align:center; margin-top:16px;"><a href="/admin/connexion">Je suis administrateur →</a></p>
</div>
</body>
</html>
