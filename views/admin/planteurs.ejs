<%- include('../partials/head', { titre: 'Planteurs' }) %>
<%- include('../partials/nav-admin') %>
<div class="container">
  <h1>Planteurs</h1>

  <% if (message) { %>
    <div class="alert info"><%= message %></div>
  <% } %>

  <div class="card">
    <div class="list-toolbar">
      <form method="GET" action="/admin/planteurs">
        <input type="text" class="search-input" name="q" placeholder="Rechercher un planteur..." value="<%= q %>">
        <button class="btn grey" type="submit">Rechercher</button>
      </form>
      <a class="btn green" href="/admin/planteurs/nouveau">+ Nouveau planteur</a>
    </div>
  </div>

  <div class="card">
    <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th class="col-center col-num">N°</th>
          <th>Planteur</th>
          <th>Contact</th>
          <th>Identifiant</th>
          <th class="col-center">Moyen de paiement</th>
          <th class="col-center">N° de paiement</th>
          <th class="col-center">Statut</th>
          <th class="col-center">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% planteurs.forEach(function(p, index) { %>
          <% var initiales = (p.nom ? p.nom.charAt(0) : '') + (p.prenoms ? p.prenoms.charAt(0) : ''); %>
          <tr>
            <td class="col-center"><%= index + 1 %></td>
            <td>
              <div class="avatar-name">
                <span class="avatar-circle"><%= initiales %></span>
                <span><%= p.nom %> <%= p.prenoms %></span>
              </div>
            </td>
            <td><%= p.contact || '-' %></td>
            <td><%= p.identifiant %></td>
            <td class="col-center"><% if (p.moyen_paiement) { %><span class="pay-pill"><%= p.moyen_paiement %></span><% } else { %><span class="muted">-</span><% } %></td>
            <td class="col-center"><span class="pay-number"><%= p.contact_paiement || '-' %></span></td>
            <td class="col-center"><span class="badge <%= p.statut %>"><%= p.statut %></span></td>
            <td class="col-center">
              <div class="cell-actions">
                <a class="btn small" href="/admin/planteurs/<%= p.id %>/modifier">Modifier</a>
                <% if (p.statut === 'actif') { %>
                  <form class="inline" method="POST" action="/admin/planteurs/<%= p.id %>/supprimer" onsubmit="return confirm('Desactiver ce planteur ? Son historique sera conserve.');">
                    <button class="btn small red" type="submit">Supprimer</button>
                  </form>
                <% } else { %>
                  <form class="inline" method="POST" action="/admin/planteurs/<%= p.id %>/reactiver">
                    <button class="btn small green" type="submit">Reactiver</button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
        <% if (planteurs.length === 0) { %>
          <tr><td colspan="8" class="muted">Aucun planteur trouve.</td></tr>
        <% } %>
      </tbody>
    </table>
    </div>
  </div>
</div>
</body>
</html>
