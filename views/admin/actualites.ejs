<%- include('../partials/head', { titre: 'Actualites Hevea' }) %>
<%- include('../partials/nav-admin') %>
<div class="container">
  <h1>Actualites Hevea</h1>
  <p class="muted" style="margin-bottom:20px;">Fil d'actualites sur l'hevea et le caoutchouc naturel en Cote d'Ivoire et en Afrique, alimente par des flux RSS et par vos publications.</p>

  <% if (message) { %>
    <div class="alert info"><%= message %></div>
  <% } %>
  <% if (erreur) { %>
    <div class="alert error"><%= erreur %></div>
  <% } %>

  <div class="card">
    <h2>Publier une actualite</h2>
    <form method="POST" action="/admin/actualites/manuelles">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label>Titre</label>
        <input type="text" name="titre" required placeholder="Ex: Le prix du kg fixe pour le mois">
      </div>
      <div class="form-group">
        <label>Resume (optionnel)</label>
        <textarea name="resume" rows="3" placeholder="Quelques lignes de contexte..."></textarea>
      </div>
      <div class="form-group">
        <label>Lien externe (optionnel)</label>
        <input type="url" name="lien" placeholder="https://...">
      </div>
      <button class="btn green" type="submit">Publier</button>
    </form>
  </div>

  <div class="card">
    <h2>Sources RSS</h2>
    <p class="muted" style="margin-bottom:14px;">Flux externes agreges automatiquement dans le fil ci-dessous (verifiees toutes les 45 minutes).</p>
    <div class="table-responsive">
    <table>
      <thead><tr><th>Nom</th><th>URL</th><th class="col-center">Statut</th><th class="col-center">Actions</th></tr></thead>
      <tbody>
        <% sources.forEach(function(s) { %>
          <tr>
            <td data-label="Nom"><%= s.nom %></td>
            <td data-label="URL" style="word-break:break-all; font-size:12px;"><%= s.url %></td>
            <td class="col-center" data-label="Statut"><span class="badge <%= s.actif ? 'actif' : 'inactif' %>"><%= s.actif ? 'Actif' : 'Desactive' %></span></td>
            <td class="col-center" data-label="Actions">
              <div class="cell-actions">
                <form class="inline" method="POST" action="/admin/actualites/sources/<%= s.id %>/toggle">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn small grey" type="submit"><%= s.actif ? 'Desactiver' : 'Activer' %></button>
                </form>
                <form class="inline" method="POST" action="/admin/actualites/sources/<%= s.id %>/supprimer" onsubmit="return confirm('Supprimer cette source ?');">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn small red" type="submit">Supprimer</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    </div>

    <h2 style="margin-top:22px;">Ajouter une source</h2>
    <form method="POST" action="/admin/actualites/sources">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-row">
        <div class="form-group">
          <label>Nom de la source</label>
          <input type="text" name="nom" required placeholder="Ex: APROMAC">
        </div>
        <div class="form-group">
          <label>URL du flux RSS</label>
          <input type="url" name="url" required placeholder="https://exemple.com/feed">
        </div>
      </div>
      <button class="btn grey" type="submit">Ajouter la source</button>
    </form>
  </div>

  <div class="card">
    <div class="actions-row" style="justify-content:space-between; align-items:center; margin-bottom:14px;">
      <h2 style="margin:0;">Fil d'actualites</h2>
      <a class="btn small grey" href="/admin/actualites?rafraichir=1">Rafraichir maintenant</a>
    </div>
    <% if (erreurChargement) { %>
      <p class="muted"><%= erreurChargement %></p>
    <% } else if (actualites.length === 0) { %>
      <%- include('../partials/empty-state', { titre: 'Aucune actualite disponible', texte: 'Les dernieres actualites de la cooperative s\'afficheront ici.' }) %>
    <% } else { %>
      <% actualites.forEach(function(a) { %>
        <div class="news-item">
          <div class="news-item-head">
            <span class="news-item-source"><%= a.source %></span>
            <% if (a.date) { %><span class="news-item-date"><%= new Date(a.date).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) %></span><% } %>
          </div>
          <h3><%= a.titre %></h3>
          <% if (a.resume) { %><p class="news-item-resume"><%= a.resume %></p><% } %>
          <% if (a.lien) { %><a class="news-item-link" href="<%= a.lien %>" target="_blank" rel="noopener noreferrer">Lire l'article complet →</a><% } %>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>
</body>
</html>
