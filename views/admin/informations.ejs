<%- include('../partials/head', { titre: 'Informations' }) %>
<%- include('../partials/nav-admin') %>
<div class="container">
  <h1>Informations</h1>
  <p class="muted" style="margin-bottom:20px;">Publiez une annonce texte, avec eventuellement une image, une video ou un audio, visible par tous les planteurs.</p>

  <% if (message) { %>
    <div class="alert info"><%= message %></div>
  <% } %>
  <% if (erreur) { %>
    <div class="alert error"><%= erreur %></div>
  <% } %>

  <div class="card">
    <h2>Nouvelle information</h2>
    <form method="POST" action="/admin/informations" enctype="multipart/form-data">
      <div class="form-group">
        <label>Titre</label>
        <input type="text" name="titre" required placeholder="Ex: Prix du kg de Juillet, reunion mensuelle...">
      </div>
      <div class="form-group">
        <label>Message</label>
        <textarea name="contenu" rows="4" placeholder="Ecrivez votre message ici..." style="width:100%; padding:10px 12px; border:1px solid var(--line); border-radius:7px; font-family:var(--font-body); font-size:14px; resize:vertical;"></textarea>
      </div>
      <div class="form-group">
        <label>Fichier joint (image, video ou audio) — optionnel</label>
        <div class="file-input-wrap">
          <input type="file" name="fichier" accept="image/*,video/*,audio/*">
          <div class="file-hint">Formats acceptes : JPG, PNG, GIF, WEBP, MP4, WEBM, MOV, MP3, WAV, OGG, M4A — 50 Mo max.</div>
        </div>
      </div>
      <button class="btn green" type="submit">Publier l'information</button>
    </form>
  </div>

  <h2 style="margin-top:28px;">Informations publiees</h2>

  <% if (informations.length === 0) { %>
    <div class="card empty-state">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><line x1="12" y1="11" x2="12" y2="16"/><circle cx="12" cy="7.5" r="0.9" fill="currentColor" stroke="none"/></svg>
      <p>Aucune information publiee pour le moment.</p>
    </div>
  <% } else { %>
    <% informations.forEach(function(info) { %>
      <div class="info-post">
        <div class="info-post-head">
          <h3><%= info.titre %></h3>
          <span class="info-post-date"><%= new Date(info.cree_le.replace(' ', 'T') + 'Z').toLocaleString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
        </div>
        <% if (info.contenu) { %>
          <div class="info-post-body"><%= info.contenu %></div>
        <% } %>
        <% if (info.fichier_nom) { %>
          <div class="info-media">
            <% if (info.fichier_type === 'image') { %>
              <img src="/uploads/informations/<%= info.fichier_nom %>" alt="<%= info.titre %>">
            <% } else if (info.fichier_type === 'video') { %>
              <video controls src="/uploads/informations/<%= info.fichier_nom %>"></video>
            <% } else if (info.fichier_type === 'audio') { %>
              <audio controls src="/uploads/informations/<%= info.fichier_nom %>"></audio>
            <% } %>
          </div>
        <% } %>
        <div class="actions-row" style="margin-top:14px;">
          <form class="inline" method="POST" action="/admin/informations/<%= info.id %>/supprimer" onsubmit="return confirm('Supprimer cette information ?');">
            <button class="btn small red" type="submit">Supprimer</button>
          </form>
        </div>
      </div>
    <% }); %>
  <% } %>
</div>
</body>
</html>
