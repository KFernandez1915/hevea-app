<%- include('../partials/head', { titre: 'Historique' }) %>
<%- include('../partials/nav-admin') %>
<div class="container">
  <h1>Historique des mois</h1>

  <% if (periodes.length === 0) { %>
    <div class="card"><%- include('../partials/empty-state', { titre: 'Aucun mois enregistre', texte: 'L\'historique se remplira automatiquement des le premier mois traite.' }) %></div>
  <% } else { %>

  <div class="card export-links">
    <strong>Exporter tout l'historique : </strong>
    <a class="btn small green" href="/admin/historique/export/pdf">Export PDF</a>
    <a class="btn small" href="/admin/historique/export/excel">Export Excel</a>
  </div>

  <div class="grid-stats">
    <div class="stat">
      <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></div>
      <div class="stat-body"><div class="label">Mois recenses</div><div class="value"><%= periodes.length %></div></div>
    </div>
    <div class="stat">
      <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9Z"/><path d="M11 3 8 9l4 12 4-12-3-6"/><path d="M2 9h20"/></svg></div>
      <div class="stat-body"><div class="label">Poids total cumule</div><div class="value"><%= totauxGeneraux.poidsTotal.toFixed(1) %> kg</div></div>
    </div>
    <div class="stat">
      <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 6v12M18 6v12"/></svg></div>
      <div class="stat-body"><div class="label">Montant total cumule</div><div class="value"><%= formaterMontant(totauxGeneraux.montantTotal) %></div></div>
    </div>
  </div>

  <div class="card">
    <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Mois</th>
          <th class="col-center">Prix du kg</th>
          <th class="col-center">Planteurs</th>
          <th class="col-center">Pesees</th>
          <th class="col-center">Poids total (kg)</th>
          <th class="col-center">Montant total</th>
          <th class="col-center">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% lignesHistorique.forEach(function(l) { %>
          <tr>
            <td data-label="Mois"><strong><%= l.libellePeriode %></strong></td>
            <td class="col-center" data-label="Prix du kg"><%= l.prixKg ? formaterMontant(l.prixKg) : 'Non defini' %></td>
            <td class="col-center" data-label="Planteurs"><%= l.nbPlanteurs %></td>
            <td class="col-center" data-label="Pesees"><%= l.nbPesees %></td>
            <td class="col-center" data-label="Poids total (kg)"><%= l.poidsTotal.toFixed(1) %></td>
            <td class="col-center" data-label="Montant total"><%= formaterMontant(l.montantTotal) %></td>
            <td class="col-center" data-label="Actions"><a class="btn small" href="/admin/recap?periode=<%= l.periode %>">Voir le detail</a></td>
          </tr>
        <% }); %>
      </tbody>
      <tfoot>
        <tr>
          <td data-label="Mois">TOTAL GENERAL</td>
          <td class="col-center" data-label="Prix du kg"></td>
          <td class="col-center" data-label="Planteurs"></td>
          <td class="col-center" data-label="Pesees"><%= totauxGeneraux.nbPesees %></td>
          <td class="col-center" data-label="Poids total (kg)"><%= totauxGeneraux.poidsTotal.toFixed(1) %></td>
          <td class="col-center" data-label="Montant total"><%= formaterMontant(totauxGeneraux.montantTotal) %></td>
          <td class="col-center" data-label="Actions"></td>
        </tr>
      </tfoot>
    </table>
    </div>
  </div>
  <% } %>
</div>
</body>
</html>
