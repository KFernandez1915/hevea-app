<%- include('../partials/head', { titre: 'Recapitulatif mensuel' }) %>
<%- include('../partials/nav-admin') %>
<div class="container">
  <h1>Recapitulatif — <%= formaterPeriode(periode) %></h1>

  <form method="GET" action="/admin/recap" style="margin-bottom:18px;">
    <div class="form-group" style="max-width:220px;">
      <label>Mois</label>
      <input type="month" name="periode" value="<%= periode %>" onchange="this.form.submit()">
    </div>
  </form>

  <% if (!prixKg) { %>
    <div class="alert error">Le prix du kg n'a pas ete defini pour ce mois — <a href="/admin/mois?periode=<%= periode %>">le renseigner</a>.</div>
  <% } else { %>

  <div class="card export-links">
    <strong>Exporter : </strong>
    <a class="btn small green" href="/admin/recap/export/pdf?periode=<%= periode %>">Export PDF</a>
    <a class="btn small" href="/admin/recap/export/excel?periode=<%= periode %>">Export Excel — complet</a>
    <a class="btn small grey" href="/admin/recap/export/excel-simplifie?periode=<%= periode %>">Export Excel — contacts &amp; paiement</a>
    <a class="btn small grey" href="/admin/recap/export/excel-nom-poids?periode=<%= periode %>">Export Excel — nom &amp; prenom / poids</a>
    <div class="muted mt-2">
      <strong>Complet</strong> : toutes les colonnes (pesees, poids, montant). <strong>Contacts &amp; paiement</strong> : nom &amp; prenom, contact de paiement, moyen de paiement. <strong>Nom &amp; prenom / poids</strong> : nom &amp; prenom et poids total uniquement.
    </div>
  </div>

  <div class="grid-stats">
    <div class="stat">
      <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M14.5 9a2.5 2.5 0 0 0-2.5-1.5c-1.5 0-2.5.9-2.5 2s1 1.6 2.5 2 2.5.9 2.5 2-1 2-2.5 2A2.5 2.5 0 0 1 9.5 14"/><path d="M12 6v1.5M12 16.5V18"/></svg></div>
      <div class="stat-body"><div class="label">Prix du kg</div><div class="value"><%= formaterMontant(prixKg) %></div></div>
    </div>
    <div class="stat">
      <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
      <div class="stat-body"><div class="label">Planteurs</div><div class="value"><%= lignes.length %></div></div>
    </div>
    <div class="stat">
      <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9Z"/><path d="M11 3 8 9l4 12 4-12-3-6"/><path d="M2 9h20"/></svg></div>
      <div class="stat-body"><div class="label">Poids total</div><div class="value"><%= totaux.poids_total.toFixed(1) %> kg</div></div>
    </div>
    <div class="stat">
      <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 6v12M18 6v12"/></svg></div>
      <div class="stat-body"><div class="label">Montant total</div><div class="value"><%= formaterMontant(totaux.montant) %></div></div>
    </div>
  </div>

  <div class="card">
    <div class="table-responsive">
    <table>
      <thead><tr><th>Planteur</th><th class="col-center">Moyen de paiement</th><th class="col-center">N° de paiement</th><th class="col-center">Nb pesees</th><th class="col-center">Poids total (kg)</th><th class="col-center">Montant</th></tr></thead>
      <tbody>
        <% lignes.forEach(function(l) { %>
          <tr>
            <td data-label="Planteur"><%= l.nom_complet %></td>
            <td class="col-center" data-label="Moyen de paiement"><% if (l.moyen_paiement) { %><span class="pay-pill"><%= l.moyen_paiement %></span><% } else { %><span class="muted">-</span><% } %></td>
            <td class="col-center" data-label="N° de paiement"><span class="pay-number"><%= l.contact_paiement || '-' %></span></td>
            <td class="col-center" data-label="Nb pesees"><%= l.nb_pesees %></td>
            <td class="col-center" data-label="Poids total (kg)"><%= l.poids_total.toFixed(1) %></td>
            <td class="col-center" data-label="Montant"><%= formaterMontant(l.montant) %></td>
          </tr>
        <% }); %>
        <% if (lignes.length === 0) { %>
          <tr><td colspan="6"><div class="empty-state-inline"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8V21H3V8"/><path d="M1 3h22v5H1z"/><path d="M10 12h4"/></svg>Aucune pesee pour ce mois.</div></td></tr>
        <% } %>
      </tbody>
      <tfoot>
        <tr><td data-label="Planteur">TOTAL</td><td class="col-center" data-label="Moyen de paiement"></td><td class="col-center" data-label="N° de paiement"></td><td class="col-center" data-label="Nb pesees"><%= totaux.nb_pesees %></td><td class="col-center" data-label="Poids total (kg)"><%= totaux.poids_total.toFixed(1) %></td><td class="col-center" data-label="Montant"><%= formaterMontant(totaux.montant) %></td></tr>
      </tfoot>
    </table>
    </div>
  </div>
  <% } %>
</div>
</body>
</html>
