<%- include('../partials/head', { titre: 'Tableau de bord' }) %>
<%- include('../partials/nav-admin') %>
<div class="container">
  <h1>Tableau de bord — <%= formaterPeriode(periode) %></h1>

  <form method="GET" action="/admin" style="margin-bottom:18px;">
    <div class="form-group" style="max-width:220px;">
      <label>Changer de mois</label>
      <input type="month" name="periode" value="<%= periode %>" onchange="this.form.submit()">
    </div>
  </form>

  <div class="grid-stats">
    <div class="stat">
      <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
      <div class="stat-body">
        <div class="label">Planteurs actifs</div>
        <div class="value"><%= nbPlanteursActifs %></div>
      </div>
    </div>
    <div class="stat">
      <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M14.5 9a2.5 2.5 0 0 0-2.5-1.5c-1.5 0-2.5.9-2.5 2s1 1.6 2.5 2 2.5.9 2.5 2-1 2-2.5 2A2.5 2.5 0 0 1 9.5 14"/><path d="M12 6v1.5M12 16.5V18"/></svg></div>
      <div class="stat-body">
        <div class="label">Prix du kg (<%= formaterPeriode(periode) %>)</div>
        <div class="value"><%= prixKg ? formaterMontant(prixKg) : 'Non defini' %></div>
      </div>
    </div>
    <div class="stat">
      <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9Z"/><path d="M11 3 8 9l4 12 4-12-3-6"/><path d="M2 9h20"/></svg></div>
      <div class="stat-body">
        <div class="label">Planteurs ayant vendu ce mois</div>
        <div class="value"><%= lignes.length %></div>
      </div>
    </div>
    <div class="stat">
      <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 6v12M18 6v12"/></svg></div>
      <div class="stat-body">
        <div class="label">Montant total du mois</div>
        <div class="value"><%= formaterMontant(totaux.montant) %></div>
      </div>
    </div>
  </div>

  <div class="card">
    <h2>Actions rapides</h2>
    <div class="actions-row">
       <a class="btn green" href="/admin/mois?periode=<%= periode %>">Saisir les pesees du mois</a>
       <a class="btn" href="/admin/recap?periode=<%= periode %>">Voir le recapitulatif complet</a>
       <a class="btn grey" href="/admin/planteurs/nouveau">Ajouter un planteur</a>
    </div>
  </div>

  <div class="card">
    <h2>Evolution du poids a chaque pesee</h2>
    <% if (toutesLesPesees.length === 0) { %>
      <%- include('../partials/empty-state', { titre: 'Aucune pesee pour le moment', texte: 'Le graphique apparaitra des la premiere pesee enregistree.' }) %>
    <% } else { %>
      <div class="chart-wrap">
        <canvas id="chartPesees"></canvas>
      </div>
    <% } %>
  </div>

  <% if (!prixKg) { %>
    <div class="alert error">Le prix du kg n'a pas encore ete defini pour ce mois. Le recapitulatif ne peut pas etre calcule tant qu'il n'est pas renseigne.</div>
  <% } %>

  <div class="card">
    <h2>Apercu du mois</h2>
    <% if (lignes.length === 0) { %>
      <%- include('../partials/empty-state', { titre: 'Aucune pesee ce mois-ci', texte: 'Saisissez une pesee pour voir apparaitre l\'apercu du mois.' }) %>
    <% } else { %>
      <div class="table-responsive">
      <table>
        <thead><tr><th>Planteur</th><th>Pesees</th><th>Poids total (kg)</th><th>Montant</th></tr></thead>
        <tbody>
          <% lignes.forEach(function(l) { %>
            <tr>
              <td data-label="Planteur"><%= l.nom_complet %></td>
              <td data-label="Pesees"><%= l.nb_pesees %></td>
              <td data-label="Poids total (kg)"><%= l.poids_total.toFixed(1) %></td>
              <td data-label="Montant"><%= formaterMontant(l.montant) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    <% } %>
  </div>
</div>

<% if (toutesLesPesees.length > 0) { %>
<script src="/js/vendor/chart.umd.min.js"></script>
<script>
  (function () {
    // JSON.stringify seul ne suffit pas : si un champ contient "</script>",
    // cela romprait hors de la balise <script> et permettrait une injection.
    // On echappe donc "<" en "\u003c" avant insertion.
    var pesees = <%- JSON.stringify(toutesLesPesees).replace(/</g, '\\u003c') %>;
    var palette = ['#205c2e', '#b9793f', '#2f7a3c', '#7a5230', '#4f9d4a', '#163d20', '#c99a5b', '#6c9e5c'];

    // Toutes les dates distinctes, triees, servent de graduation d'axe X commune.
    var labels = Array.from(new Set(pesees.map(function (p) { return p.date_pesee; }))).sort();

    // Regroupement par planteur : une serie par planteur, alignee sur "labels"
    // (valeur nulle les jours sans pesee, pour ne pas relier des points sans lien).
    var parPlanteur = {};
    pesees.forEach(function (p) {
      if (!parPlanteur[p.nom_complet]) parPlanteur[p.nom_complet] = {};
      parPlanteur[p.nom_complet][p.date_pesee] = p.poids_kg;
    });

    var noms = Object.keys(parPlanteur);
    var datasets = noms.map(function (nom, i) {
      var couleur = palette[i % palette.length];
      return {
        label: nom,
        data: labels.map(function (d) { return parPlanteur[nom][d] != null ? parPlanteur[nom][d] : null; }),
        borderColor: couleur,
        backgroundColor: couleur,
        spanGaps: true,
        tension: 0.25,
        pointRadius: 3,
        pointHoverRadius: 5,
        borderWidth: 2,
      };
    });

    var labelsFormates = labels.map(function (d) {
      var parts = d.split('-');
      return parts.length === 3 ? (parts[2] + '/' + parts[1] + '/' + parts[0].slice(2)) : d;
    });

    new Chart(document.getElementById('chartPesees'), {
      type: 'line',
      data: { labels: labelsFormates, datasets: datasets },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'nearest', axis: 'x', intersect: false },
        plugins: {
          legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } },
          tooltip: { callbacks: { label: function (ctx) { return ctx.dataset.label + ' : ' + ctx.parsed.y + ' kg'; } } },
        },
        scales: {
          y: { title: { display: true, text: 'Poids (kg)' }, beginAtZero: true },
          x: { title: { display: true, text: 'Date de pesee' } },
        },
      },
    });
  })();
</script>
<% } %>
</body>
</html>
