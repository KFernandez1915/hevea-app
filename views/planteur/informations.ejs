<%- include('../partials/head', { titre: 'Informations' }) %>
<%- include('../partials/nav-planteur') %>
<div class="container">
  <h1>Informations</h1>
  <p class="muted" style="margin-bottom:20px;">Annonces et messages publies par l'association.</p>

  <% if (typeof mdpTemporaire !== 'undefined' && mdpTemporaire) { %>
    <div class="alert error">Vous utilisez encore un mot de passe temporaire. <a href="/planteur">Modifiez-le des maintenant</a>.</div>
  <% } %>

  <% if (informations.length === 0) { %>
    <div class="card"><%- include('../partials/empty-state', { titre: 'Aucune information publiee', texte: 'Les annonces de la cooperative s\'afficheront ici des qu\'elles seront publiees.' }) %></div>
  <% } else { %>
    <% informations.forEach(function(info) { %>
      <div class="info-post">
        <div class="info-post-head">
          <h3><%= info.titre %><% if (info.estNouveau) { %> <span class="badge actif" style="margin-left:6px;">Nouveau</span><% } %></h3>
          <span class="info-post-date"><%= new Date(info.cree_le.replace(' ', 'T') + 'Z').toLocaleString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
        </div>
        <% if (info.contenu) { %>
          <div class="info-post-body"><%= info.contenu %></div>
        <% } %>
        <% if (info.fichier_nom) { %>
          <div class="info-media">
            <% if (info.fichier_type === 'image') { %>
              <img src="/uploads/informations/<%= info.fichier_nom %>" alt="<%= info.titre %>">
            <% } else if (info.fichier_type === 'video') { %>
              <video controls src="/uploads/informations/<%= info.fichier_nom %>"></video>
            <% } else if (info.fichier_type === 'audio') { %>
              <audio controls src="/uploads/informations/<%= info.fichier_nom %>"></audio>
            <% } %>
          </div>
        <% } %>
      </div>
    <% }); %>
  <% } %>
</div>
</body>
</html>
