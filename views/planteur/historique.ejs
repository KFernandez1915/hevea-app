<%- include('../partials/head', { titre: 'Mon historique' }) %>
<%- include('../partials/nav-planteur') %>
<div class="container">
  <h1>Mon historique</h1>

  <% if (historique.length === 0) { %>
    <div class="card"><p class="muted">Aucun historique disponible pour le moment.</p></div>
  <% } else { %>
    <div class="card">
      <div class="table-responsive">
      <table>
        <thead><tr><th>Mois</th><th>Prix du kg</th><th>Poids total (kg)</th><th>Montant</th></tr></thead>
        <tbody>
          <% historique.forEach(function(h) { %>
            <tr>
              <td><%= formaterPeriode(h.periode) %></td>
              <td><%= h.prixKg ? formaterMontant(h.prixKg) : 'Non defini' %></td>
              <td><%= h.poidsTotal.toFixed(1) %></td>
              <td><%= formaterMontant(h.montant) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    </div>
  <% } %>
</div>
</body>
</html>
