<%- include('../partials/head', { titre: 'Actualites Hevea' }) %>
<%- include('../partials/nav-planteur') %>
<div class="container">
  <h1>Actualites Hevea</h1>
  <p class="muted" style="margin-bottom:20px;">Ce qui se passe dans la filiere hevea en Cote d'Ivoire et en Afrique.</p>

  <div class="card">
    <% if (erreurChargement) { %>
      <p class="muted"><%= erreurChargement %></p>
    <% } else if (actualites.length === 0) { %>
      <%- include('../partials/empty-state', { titre: 'Aucune actualite disponible', texte: 'Les dernieres actualites de la cooperative s\'afficheront ici.' }) %>
    <% } else { %>
      <% actualites.forEach(function(a) { %>
        <div class="news-item">
          <div class="news-item-head">
            <span class="news-item-source"><%= a.source %></span>
            <% if (a.date) { %><span class="news-item-date"><%= new Date(a.date).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) %></span><% } %>
          </div>
          <h3><%= a.titre %></h3>
          <% if (a.resume) { %><p class="news-item-resume"><%= a.resume %></p><% } %>
          <% if (a.lien) { %><a class="news-item-link" href="<%= a.lien %>" target="_blank" rel="noopener noreferrer">Lire l'article complet →</a><% } %>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>
</body>
</html>
